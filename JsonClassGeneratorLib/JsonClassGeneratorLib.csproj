<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- NuGet metadata -->
    <PackageId>Json2CSharp.JsonClassGenerator</PackageId>
    <Version>1.0.2</Version>
    <Authors>Hilal Hakla</Authors>
    <Company>Json2CSharp</Company>
    <Description>JSON class generator library</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hilal-hakla/Json2CSharpCodeGenerator</RepositoryUrl>

    <!-- Optional but useful -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CG.Pluralization" Version="0.3000.12" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

</Project>